# Mycel compose config. Copy to .env and fill in.
#
# NOTHING SECRET GOES IN HERE. Every secret lives in Google Secret Manager and
# is resolved at container start through the instance's attached service
# account (ADR 0030) — there is no key file, no bootstrap token, and no
# credential at rest on this box. This file carries only the shape.
#
# The environment-variable-name → secret-id mapping lives in
# docker-compose.yml as MYCEL_SECRETS, in plain sight, because it holds names.

# Public hostname. Caddy issues the cert from the container label, so this needs
# an A record at mycel-host's static IP.
#
# NOT under *.habitats.thefocus.ai: the wildcard would be free, but Mycel is not
# a habitat, and putting it there says it is.
MYCEL_HOSTNAME=mycel.thefocus.ai

# Below 7440, where Gaia starts assigning ports to the containers it manages.
# Kept even though Mycel no longer shares a host with Gaia — the supplier
# agent's managed runtime still defaults to 7439 and a machine may run both.
MYCEL_PORT=7438

# Browser-safe key for Mycel's own Clerk application (STD-009 §3.1). Use a
# pk_live key here in production; the client build never receives a secret key.
VITE_CLERK_PUBLISHABLE_KEY=

# Temporary bridge only: set true while mycel.thefocus.ai intentionally uses
# the Mycel development instance. deploy.sh otherwise refuses pk_test keys.
# Remove this exception when Clerk's production domain and OAuth are wired.
MYCEL_ALLOW_DEVELOPMENT_CLERK=false

# Token verifier for the same Clerk application. For a Clerk development
# instance this is https://<instance>.clerk.accounts.dev. Keep authorized
# parties to the exact browser origin so a token minted for another site is
# rejected even if it came from this Clerk instance.
MYCEL_CLERK_ISSUER=
MYCEL_CLERK_AUTHORIZED_PARTIES=https://mycel.thefocus.ai

# Postpaid exposure automatically available to each self-service Client, in
# integer micro-dollars. Keep zero until billing approval is deliberate.
MYCEL_SELF_SERVICE_CREDIT_LIMIT_MICRO_DOLLARS=0

# Public URL used only for Stripe Checkout redirects. Funding stays unavailable
# unless this and both Stripe secrets are configured together. Put secret
# VALUES in Secret Manager, then add their env-name → secret-id mappings to
# MYCEL_SECRETS in docker-compose.yml; never put them in this file.
MYCEL_PUBLIC_ORIGIN=https://mycel.thefocus.ai
# MYCEL_STRIPE_SECRET_KEY → Secret Manager (test key first)
# MYCEL_STRIPE_WEBHOOK_SECRET → Secret Manager (unique test endpoint secret)

# Let's Encrypt registration address for this host's Caddy.
CADDY_EMAIL=

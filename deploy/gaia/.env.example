# Copy to deploy/gaia/.env and fill in. Used by docker-compose.yml and redeploy.sh.

# --- Gaia HabitatHost (pi-durable) default model & port ---
GAIA_PROVIDER=mycel
GAIA_MODEL=default
GAIA_PORT=7420

# --- Public hostname & authentication ---
# Served over TLS by Caddy (`caddy: $GAIA_HOSTNAME`, `{{upstreams 7420}}`).
GAIA_HOSTNAME=gaia.habitats.example.com

# Comma-separated static operator bearer keys (`Authorization: Bearer <key>`).
# Required on any reachable deployment; first key is used by redeploy.sh smoke check.
# Generate: openssl rand -hex 32
GAIA_API_KEY=

# Optional per-speaker JWT verification (`jose` against SaaS JWKS).
# When set alongside GAIA_API_KEY, enables `jwt+bearer` dual auth and advertises
# `bearerFormat: "JWT"` in `/.well-known/agent-card.json`.
# GAIA_JWKS_URL=https://habitats.thefocus.ai/.well-known/jwks.json
# GAIA_AUTH_AUDIENCE=https://gaia.habitats.example.com

# Optional wildcard domain for `<id>.$GAIA_BASE_DOMAIN` subdomain routing.
# When unset, child Habitats are addressed at `https://$GAIA_HOSTNAME/habitats/<id>/...`.
# GAIA_BASE_DOMAIN=habitats.example.com

# Existing Caddy Docker network to attach the `gaia` container to (e.g. `caddy`).
GAIA_INGRESS_NETWORK=caddy

# --- Upstream model credentials ---
MYCEL_URL=https://mycel.thefocus.ai
MYCEL_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "rootDir": "src",
    "types": ["vitest/globals"]
  },
  // serve/ is deliberately OUT of this program: src/ must stay isomorphic
  // (no node types in scope proves it). serve/serve-shell.ts is typechecked
  // through its consumers — the habitat and mycel programs both compile it.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.test.ts"]
}

{
  "name": "@umwelten/cli",
  "version": "0.6.0",
  "type": "module",
  "main": "./src/cli.ts",
  "types": "./src/cli.ts",
  "bin": {
    "umwelten": "src/entry.ts"
  },
  "description": "Focused CLI for Umwelten sessions, DurableHabitats, GPU Suppliers, and Mycel Exchange",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "cli": "NODE_OPTIONS='--no-deprecation' tsx src/entry.ts",
    "test:run": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@umwelten/habitat": "workspace:*",
    "@umwelten/mycel": "workspace:*",
    "@umwelten/pi": "workspace:*",
    "@umwelten/sessions": "workspace:*",
    "@umwelten/supplier": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "private": true
}

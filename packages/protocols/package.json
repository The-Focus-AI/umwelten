    "@earendil-works/pi-mcp": "1.6.0",
    "@leocavalcante/pi-a2a": "0.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "private": true

{
  "name": "@umwelten/evaluation",
  "version": "0.4.13",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "description": "Model evaluation, ranking, reporting, and session introspection",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Focus-AI/umwelten.git",
    "directory": "packages/evaluation"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --reporter=verbose",
    "test:run": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.4",
    "@ai-sdk/provider-utils": "^5.0.14",
    "@umwelten/core": "workspace:*",
    "@umwelten/sessions": "workspace:*",
    "ai": "^7.0.41",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dagger.io/dagger": "^0.21.7",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*.js": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    }
  }
}

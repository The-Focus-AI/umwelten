{
  "name": "@umwelten/pi",
  "version": "0.6.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./models.js": {
      "types": "./src/models.ts",
      "import": "./src/models.ts"
    }
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "umwelten",
    "sessions"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "description": "Installable Pi extension (session search, Explorations, knowledge promotion) + thin @earendil-works/pi-ai turn helpers",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test:run": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@umwelten/sessions": "workspace:*",
    "dotenv": "^17.4.2",
    "undici": "^8.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "private": true
}

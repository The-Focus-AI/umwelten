{
  "name": "umwelten",
  "version": "0.6.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./mcp-serve": {
      "types": "./src/mcp-serve.ts",
      "import": "./src/mcp-serve.ts"
    }
  },
  "bin": {
    "umwelten": "src/entry.ts"
  },
  "description": "Multi-model evaluations, cross-harness session sensemaking, DurableHabitats, and the Mycel Token Exchange — built on Pi and Pi Durable",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Focus-AI/umwelten.git",
    "directory": "packages/umwelten"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-codemode": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-env": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@leocavalcante/pi-a2a": "0.5.1",
    "@mcp-ui/server": "^6.1.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "jose": "^6.2.4",
    "undici": "^8.9.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@umwelten/cli": "workspace:*",
    "@umwelten/evaluation": "workspace:*",
    "@umwelten/habitat": "workspace:*",
    "@umwelten/mycel": "workspace:*",
    "@umwelten/pi": "workspace:*",
    "@umwelten/protocols": "workspace:*",
    "@umwelten/sessions": "workspace:*",
    "@umwelten/substrate": "workspace:*",
    "@umwelten/supplier": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./mcp-serve": {
        "types": "./dist/mcp-serve.d.ts",
        "import": "./dist/mcp-serve.js"
      }
    },
    "bin": {
      "umwelten": "dist/cli/entry.js"
    }
  }
}

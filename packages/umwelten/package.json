{
  "name": "umwelten",
  "version": "0.4.13",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./mcp-serve": {
      "types": "./src/mcp-serve.ts",
      "import": "./src/mcp-serve.ts"
    }
  },
  "bin": {
    "umwelten": "src/entry.ts"
  },
  "description": "Habitat agent environments, multi-provider LLM access, and systematic model evaluation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Focus-AI/umwelten.git",
    "directory": "packages/umwelten"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@umwelten/core": "workspace:*",
    "@umwelten/protocols": "workspace:*",
    "@umwelten/habitat": "workspace:*",
    "@umwelten/evaluation": "workspace:*",
    "@umwelten/ui": "workspace:*",
    "@umwelten/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./mcp-serve": {
        "types": "./dist/mcp-serve.d.ts",
        "import": "./dist/mcp-serve.js"
      }
    },
    "bin": {
      "umwelten": "dist/entry.js"
    }
  }
}

{
  "name": "@umwelten/exchange",
  "version": "0.1.0",
  "description": "Buys model tokens wholesale from Suppliers and resells them retail to Applications",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}

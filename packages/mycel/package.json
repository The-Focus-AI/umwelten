{
  "name": "@umwelten/mycel",
  "version": "0.4.13",
  "description": "Mycel — the Exchange: buys model tokens wholesale from Suppliers and resells them retail to Applications",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsup"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "commander": "^15.0.0",
    "jose": "^6.2.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "private": true
}

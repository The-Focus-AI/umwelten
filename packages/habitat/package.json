  },
  "scripts": {
    "test:run": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-codemode": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-env": "1.6.0",
    "@earendil-works/pi-mcp": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@leocavalcante/pi-a2a": "0.5.1",
    "@mcp-ui/server": "^6.1.0",
    "@umwelten/pi": "workspace:*",
    "@umwelten/protocols": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "private": true

{
  "name": "umwelten-workspace",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Umwelten — Model evaluations, session sensemaking, DurableHabitats, and the Mycel Token Exchange on Pi and Pi Durable",
  "scripts": {
    "test:run": "vitest run --reporter=verbose",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "test:all": "pnpm test:run && pnpm test:integration",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" && eslint --no-ignore \"examples/**/*.ts\"",
    "cli": "NODE_OPTIONS='--no-deprecation' tsx packages/cli/src/entry.ts",
    "specs:check": "node --experimental-strip-types .agents/skills/spec-refactor/scripts/check-specs.ts --root .",
    "specs:effective": "node --experimental-strip-types .agents/skills/spec-refactor/scripts/check-specs.ts --root . --effective",
    "specs:bundle": "node --experimental-strip-types .agents/skills/spec-refactor/scripts/check-specs.ts --root . --bundle",
    "site:extract-archives": "tsx scripts/extract-historical-reports.ts",
    "site:sync-local-labs": "tsx scripts/sync-local-labs.ts",
    "site:bench": "tsx examples/model-watch/run.ts",
    "bench:code": "tsx examples/coding-bench/run.ts",
    "bench:interactive": "tsx examples/coding-bench/interactive.ts",
    "bench:ui": "tsx scripts/bench-ui-server.ts",
    "bench:models": "tsx scripts/bench-models.ts",
    "demo:multi-a2a": "tsx examples/multi-a2a/e2e.ts",
    "demo:client-env": "tsx examples/client-env/run.ts",
    "site:build": "tsx scripts/build-site.ts",
    "typecheck": "for d in packages/*/tsconfig.json examples/tsconfig.json; do tsc --noEmit -p \"$d\" || exit 1; done"
  },
  "keywords": [
    "pi",
    "pi-durable",
    "pi-extension",
    "evaluation",
    "sessions",
    "a2a",
    "mcp"
  ],
  "author": "The Focus AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Focus-AI/umwelten.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.0.8",
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@umwelten/cli": "workspace:*",
    "@umwelten/evaluation": "workspace:*",
    "@umwelten/habitat": "workspace:*",
    "@umwelten/mycel": "workspace:*",
    "@umwelten/pi": "workspace:*",
    "@umwelten/protocols": "workspace:*",
    "@umwelten/sessions": "workspace:*",
    "@umwelten/substrate": "workspace:*",
    "@umwelten/supplier": "workspace:*",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "jose": "^6.2.4",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}

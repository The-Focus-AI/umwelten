{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": ["../node_modules/@types", "../packages/pi/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": [
    "**/node_modules/**",
    "**/jeeves-bot-data-dir/**",
    "**/sessions/**",
    "twitter-habitat/**",
    "pi-coder/**"
  ]
}
